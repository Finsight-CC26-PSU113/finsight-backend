                  "if (!recommendationId) {",
                  "    throw new Error('recommendation_id is empty. Run Get Recommendations first and ensure the user has recommendation data.');",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
