// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/prisma"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// ENUMS
// -----------------------------------------------------------------------------

enum RiskLevel {
  low
  medium
  high

  @@map("risk_level_enum")
}

enum PaymentMethod {
  cash
  debit_card
  credit_card
  e_wallet
  bank_transfer

  @@map("payment_method_enum")
}

/// income = pemasukan, expense = pengeluaran,
/// savings_deposit = alokasi ke tujuan tabungan (mengurangi saldo utama),
/// savings_withdraw = penarikan dari tujuan tabungan (menambah saldo utama)
enum TransactionType {
  income
  expense
  savings_deposit
  savings_withdraw

  @@map("transaction_type_enum")
}

/// Kategori sistem yang fix (seed data)
enum CategoryName {
  makanan
  transport
  hiburan
  belanja
  kesehatan
  tagihan
  lainnya

  @@map("category_name_enum")
}

/// Tier threshold budget alert: warning=70%, alert=90%, over=100%
enum AlertLevel {
  warning
  alert
  over

  @@map("alert_level_enum")
}

/// Status rekomendasi penghematan
enum RecommendationStatus {
  active
  done
  dismissed

  @@map("recommendation_status_enum")
}

/// Prioritas rekomendasi penghematan
enum RecommendationPriority {
  high
  medium
  low

  @@map("recommendation_priority_enum")
}

/// Kategori produk investasi (catalog + portfolio tracking).
enum InvestmentCategory {
  stock
  mutual_fund
  bond
  gold

  @@map("investment_category_enum")
}

/// Arah mutasi dana pada tujuan tabungan.
enum SavingsLedgerType {
  deposit
  withdraw

  @@map("savings_ledger_type_enum")
}

// -----------------------------------------------------------------------------
// MODELS
// -----------------------------------------------------------------------------

/// Registered user accounts for the FinSight application.
model User {
  id                          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                        String    @db.VarChar(100)
  email                       String    @unique @db.VarChar(255)
  password                    String    @db.VarChar(255)
  phone                       String?   @db.VarChar(16)
  birthday                    DateTime? @db.Date
  avatar                      String?   @db.Text
  push_notifications_enabled  Boolean   @default(true)
  email_notifications_enabled Boolean   @default(false)
  investment_portfolio_value  Decimal   @default(0) @db.Decimal(15, 2)
  financial_goal_name         String?   @db.VarChar(100)
  financial_goal_target       Decimal?  @db.Decimal(15, 2)
  financial_goal_saved        Decimal?  @db.Decimal(15, 2)
  created_at                  DateTime  @default(now()) @db.Timestamptz()
  updated_at                  DateTime  @updatedAt @db.Timestamptz()

  // Relations
  risk_profiles              UserRiskProfile[]
  investment_recommendations InvestmentRecommendation[]
  transactions               Transaction[]
  transactions_feedback      TransactionFeedback[]
  recommendations            Recommendation[]
  budgets                    Budget[]
  alerts                     Alert[]
  user_categories            UserCategory[]
  portfolio_positions        PortfolioPosition[]
  savings_goals              SavingsGoal[]
  savings_ledger             SavingsLedger[]

  @@map("users")
}

/// Kategori sistem (fix, di-seed). Hanya dipakai untuk expense.
/// Income tidak perlu kategori — langsung masuk sebagai saldo.
model Category {
  id   String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name CategoryName @unique

  // Relations
  transactions          Transaction[]
  transactions_feedback TransactionFeedback[]
  recommendations       Recommendation[]
  budgets               Budget[]
  alerts                Alert[]

  @@map("categories")
}

/// Kategori custom buatan user sendiri (expense only).
model UserCategory {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String   @db.Uuid
  name       String   @db.VarChar(100)
  created_at DateTime @default(now()) @db.Timestamptz()

  user         User          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([user_id, name])
  @@index([user_id])
  @@map("user_categories")
}

/// Financial transaction records — income maupun expense.
/// Jika type=income: category_id, user_category_id, category_predicted, confidence_score,
/// is_anomaly, dan anomaly_score diabaikan / null.
model Transaction {
  id                 String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id            String          @db.Uuid
  transaction_type   TransactionType @default(expense)
  category_id        String?         @db.Uuid
  user_category_id   String?         @db.Uuid
  savings_goal_id    String?         @db.Uuid
  description        String?         @db.Text
  amount             Decimal         @db.Decimal(15, 2)
  payment_method     PaymentMethod
  transaction_date   DateTime        @db.Date
  // AI fields — diisi oleh ML service, null untuk income
  category_predicted String?         @db.VarChar(255)
  confidence_score   Float?
  is_anomaly         Boolean         @default(false)
  anomaly_score      Float?
  created_at         DateTime        @default(now()) @db.Timestamptz()

  // Relations
  user          User                  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  category      Category?             @relation(fields: [category_id], references: [id], onDelete: Restrict)
  user_category UserCategory?         @relation(fields: [user_category_id], references: [id], onDelete: SetNull)
  savings_goal  SavingsGoal?          @relation(fields: [savings_goal_id], references: [id], onDelete: SetNull)
  feedback      TransactionFeedback[]

  @@index([user_id])
  @@index([category_id])
  @@index([savings_goal_id])
  @@index([transaction_date])
  @@index([user_id, transaction_type])
  @@index([user_id, transaction_date])
  @@map("transactions")
}

/// Tujuan tabungan pengguna (nama, target, dana terkumpul, deadline opsional).
model SavingsGoal {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id       String    @db.Uuid
  name          String    @db.VarChar(100)
  target_amount Decimal   @db.Decimal(15, 2)
  saved_amount  Decimal   @default(0) @db.Decimal(15, 2)
  deadline      DateTime? @db.Date
  created_at    DateTime  @default(now()) @db.Timestamptz()
  updated_at    DateTime  @updatedAt @db.Timestamptz()

  user         User          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([user_id])
  @@map("savings_goals")
}

/// User correction feedback untuk kategorisasi transaksi (feedback loop TF Classifier).
model TransactionFeedback {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id               String   @db.Uuid
  transaction_id        String   @db.Uuid
  corrected_category_id String   @db.Uuid
  feedback_type         String?  @db.VarChar(50)
  created_at            DateTime @default(now()) @db.Timestamptz()

  // Relations
  user               User        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  transaction        Transaction @relation(fields: [transaction_id], references: [id], onDelete: Cascade)
  corrected_category Category    @relation(fields: [corrected_category_id], references: [id], onDelete: Restrict)

  @@index([user_id])
  @@index([transaction_id])
  @@index([corrected_category_id])
  @@map("transactions_feedback")
}

/// Budget bulanan per kategori yang di-set user saat onboarding atau menu Budget.
model Budget {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String   @db.Uuid
  category_id String   @db.Uuid
  amount      Decimal  @db.Decimal(15, 2)
  period      String   @db.VarChar(7)
  start_date  DateTime @db.Timestamptz()
  end_date    DateTime @db.Timestamptz()
  created_at  DateTime @default(now()) @db.Timestamptz()

  // Relations
  user     User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  category Category @relation(fields: [category_id], references: [id], onDelete: Restrict)
  alerts   Alert[]

  @@unique([user_id, category_id, period])
  @@index([user_id])
  @@index([category_id])
  @@map("budgets")
}

/// Alert notifikasi saat pengeluaran menyentuh threshold (70/90/100%).
model Alert {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String     @db.Uuid
  category_id String     @db.Uuid
  budget_id   String     @db.Uuid
  level       AlertLevel
  message     String     @db.Text
  percentage  Float
  is_read     Boolean    @default(false)
  read_at     DateTime?  @db.Timestamptz()
  created_at  DateTime   @default(now()) @db.Timestamptz()

  // Relations
  user     User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  category Category @relation(fields: [category_id], references: [id], onDelete: Restrict)
  budget   Budget   @relation(fields: [budget_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([category_id])
  @@index([budget_id])
  @@index([is_read])
  @@map("alerts")
}

/// Rekomendasi penghematan dari Decision Engine (rule-based + statistical).
model Recommendation {
  id          String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String                 @db.Uuid
  category_id String                 @db.Uuid
  type        String                 @db.VarChar(100)
  message     String                 @db.VarChar(1000)
  priority    RecommendationPriority
  status      RecommendationStatus   @default(active)
  created_at  DateTime               @default(now()) @db.Timestamptz()
  updated_at  DateTime               @updatedAt @db.Timestamptz()

  // Relations
  user     User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  category Category @relation(fields: [category_id], references: [id], onDelete: Restrict)

  @@index([user_id])
  @@index([category_id])
  @@index([user_id, status])
  @@map("recommendations")
}

// -----------------------------------------------------------------------------
// V2 — INVESTMENT SUGGESTION
// -----------------------------------------------------------------------------

/// Risk-tolerance profile yang dihasilkan dari kuesioner onboarding.
model UserRiskProfile {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String    @db.Uuid
  risk_level RiskLevel
  score      Int
  answer     Json
  created_at DateTime  @default(now()) @db.Timestamptz()
  updated_at DateTime  @updatedAt @db.Timestamptz()

  // Relations
  user                       User                       @relation(fields: [user_id], references: [id], onDelete: Cascade)
  answers                    RiskProfileAnswer[]
  investment_recommendations InvestmentRecommendation[]

  @@index([user_id])
  @@map("user_risk_profiles")
}

/// Jawaban individual dari kuesioner risk profiling.
model RiskProfileAnswer {
  id              String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profile_user_id String @db.Uuid
  question        String @db.VarChar(10)
  answer          String @db.VarChar(5)

  // Relations
  profile UserRiskProfile @relation(fields: [profile_user_id], references: [id], onDelete: Cascade)

  @@index([profile_user_id])
  @@map("risk_profile_answers")
}

/// Rekomendasi instrumen investasi berbasis AI (V2).
model InvestmentRecommendation {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id             String   @db.Uuid
  risk_profile_id     String   @db.Uuid
  instrument_type     String   @db.VarChar(255)
  instrument_name     String   @db.VarChar(255)
  expected_return_min Float
  expected_return_max Float
  created_at          DateTime @default(now()) @db.Timestamptz()
  updated_at          DateTime @updatedAt @db.Timestamptz()

  // Relations
  user         User            @relation(fields: [user_id], references: [id], onDelete: Cascade)
  risk_profile UserRiskProfile @relation(fields: [risk_profile_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([risk_profile_id])
  @@map("investment_recommendations")
}

/// Catalog produk investasi (info-only, harga realtime via quotes API).
model InvestmentProduct {
  id          String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  category    InvestmentCategory
  symbol      String             @unique @db.VarChar(64)
  name        String             @db.VarChar(255)
  provider    String?            @db.VarChar(100)
  currency    String             @default("IDR") @db.VarChar(10)
  risk_level  RiskLevel?
  // Optional product details (for detail page)
  tenor_months Int?
  coupon_rate  Float?
  // Historical return snapshot (optional; can be null if provider not ready)
  return_1y   Float?
  return_3y   Float?
  meta        Json?
  created_at  DateTime           @default(now()) @db.Timestamptz()
  updated_at  DateTime           @updatedAt @db.Timestamptz()

  // Relations
  positions PortfolioPosition[]

  @@index([category])
  @@index([symbol])
  @@map("investment_products")
}

/// Posisi portofolio investasi manual per user.
model PortfolioPosition {
  id         String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String             @db.Uuid
  product_id String             @db.Uuid
  quantity   Decimal            @db.Decimal(20, 8)
  avg_cost   Decimal?           @db.Decimal(20, 8)
  purchased_at DateTime?        @db.Timestamptz()
  created_at DateTime           @default(now()) @db.Timestamptz()
  updated_at DateTime           @updatedAt @db.Timestamptz()

  // Relations
  user    User             @relation(fields: [user_id], references: [id], onDelete: Cascade)
  product InvestmentProduct @relation(fields: [product_id], references: [id], onDelete: Restrict)

  @@index([user_id])
  @@index([product_id])
  @@unique([user_id, product_id])
  @@map("portfolio_positions")
}

// -----------------------------------------------------------------------------
// SAVINGS GOALS (tujuan tabungan)
// -----------------------------------------------------------------------------

/// Tujuan tabungan user. saved_amount adalah akumulasi dana yang dialokasikan
/// dari saldo utama (deposit) dikurangi penarikan (withdraw).
model SavingsGoal {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id       String    @db.Uuid
  name          String    @db.VarChar(100)
  target_amount Decimal   @db.Decimal(15, 2)
  saved_amount  Decimal   @default(0) @db.Decimal(15, 2)
  deadline      DateTime? @db.Date
  is_completed  Boolean   @default(false)
  created_at    DateTime  @default(now()) @db.Timestamptz()
  updated_at    DateTime  @updatedAt @db.Timestamptz()

  // Relations
  user   User            @relation(fields: [user_id], references: [id], onDelete: Cascade)
  ledger SavingsLedger[]

  @@index([user_id])
  @@map("savings_goals")
}

/// Riwayat mutasi dana (setor/tarik) pada sebuah tujuan tabungan.
model SavingsLedger {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id        String            @db.Uuid
  goal_id        String            @db.Uuid
  type           SavingsLedgerType
  amount         Decimal           @db.Decimal(15, 2)
  payment_method PaymentMethod     @default(bank_transfer)
  created_at     DateTime          @default(now()) @db.Timestamptz()

  // Relations
  user User        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  goal SavingsGoal @relation(fields: [goal_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([goal_id])
  @@map("savings_ledger")
}
