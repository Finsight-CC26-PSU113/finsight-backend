# Database
DATABASE_URL=postgresql://postgres:<yourPassword>@localhost:5432/finsight?schema=public

# App
NODE_ENV=development
PORT=3000

# Auth
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# AI service (ML/OCR) — ganti dengan URL ngrok/tunnel yang aktif
AI_SERVICE_URL=http://localhost:8000

# Gemini API key — ambil dari https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Frontend origin for CORS
CLIENT_URL=http://localhost:5173
