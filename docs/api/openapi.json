{
  "openapi": "3.0.3",
  "info": {
    "title": "Finsight API",
    "description": "REST API for Finsight - Financial Management Application",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Local Development"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "User": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "name": { "type": "string" },
          "email": { "type": "string", "format": "email" },
          "phone": { "type": "string", "nullable": true },
          "birthday": { "type": "string", "format": "date", "nullable": true },
          "avatar": { "type": "string", "nullable": true },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" }
        }
      },
      "Category": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "name": {
            "type": "string",
            "enum": ["makanan", "transport", "hiburan", "belanja", "kesehatan", "tagihan", "lainnya"]
          }
        }
      },
      "UserCategory": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "user_id": { "type": "string", "format": "uuid" },
          "name": { "type": "string" },
          "created_at": { "type": "string", "format": "date-time" }
        }
      },
      "SuccessResponse": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "example": "success" },
          "message": { "type": "string" },
          "data": { "type": "object" }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "example": "error" },
          "message": { "type": "string" },
          "errors": {
            "type": "array",
            "items": { "type": "string" },
            "nullable": true
          }
        }
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "Unauthorized",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" },
            "example": { "status": "error", "message": "Unauthorized" }
          }
        }
      },
      "NotFound": {
        "description": "Not Found",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" },
            "example": { "status": "error", "message": "Category not found" }
          }
        }
      },
      "ValidationError": {
        "description": "Validation Failed",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" },
            "example": {
              "status": "error",
              "message": "Validation failed",
              "errors": ["\"email\" must be a valid email"]
            }
          }
        }
      }
    }
  },
  "paths": {
    "/register": {
      "post": {
        "tags": ["Auth"],
        "summary": "Register a new user",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name", "email", "password"],
                "properties": {
                  "name": { "type": "string", "maxLength": 100, "example": "Budi Santoso" },
                  "email": { "type": "string", "format": "email", "example": "budi@example.com" },
                  "password": { "type": "string", "minLength": 8, "example": "password123" },
                  "phone": { "type": "string", "maxLength": 16, "example": "081234567890" },
                  "birthday": { "type": "string", "format": "date", "example": "2000-05-13" }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Registration successful",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SuccessResponse" },
                "example": {
                  "status": "success",
                  "message": "Registration successful",
                  "data": {
                    "user": {
                      "id": "uuid",
                      "name": "Budi Santoso",
                      "email": "budi@example.com",
                      "phone": null,
                      "birthday": null,
                      "avatar": null,
                      "created_at": "2026-05-13T00:00:00.000Z",
                      "updated_at": "2026-05-13T00:00:00.000Z"
                    },
                    "token": "eyJhbGci..."
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "409": {
            "description": "Email already registered",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "example": { "status": "error", "message": "Email already registered" }
              }
            }
          }
        }
      }
    },
    "/login": {
      "post": {
        "tags": ["Auth"],
        "summary": "Login user",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password"],
                "properties": {
                  "email": { "type": "string", "format": "email", "example": "budi@example.com" },
                  "password": { "type": "string", "example": "password123" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login successful",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SuccessResponse" },
                "example": {
                  "status": "success",
                  "message": "Login successful",
                  "data": {
                    "user": {
                      "id": "uuid",
                      "name": "Budi Santoso",
                      "email": "budi@example.com"
                    },
                    "token": "eyJhbGci..."
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": {
            "description": "Invalid credentials",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "example": { "status": "error", "message": "Invalid email or password" }
              }
            }
          }
        }
      }
    },
    "/logout": {
      "post": {
        "tags": ["Auth"],
        "summary": "Logout user",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Logout successful",
            "content": {
              "application/json": {
                "example": { "status": "success", "message": "Logout successful" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/profile": {
      "get": {
        "tags": ["User"],
        "summary": "Get current user profile",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Profile retrieved",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SuccessResponse" },
                "example": {
                  "status": "success",
                  "message": "Profile retrieved",
                  "data": {
                    "user": {
                      "id": "uuid",
                      "name": "Budi Santoso",
                      "email": "budi@example.com",
                      "phone": null,
                      "birthday": null,
                      "avatar": null,
                      "created_at": "2026-05-13T00:00:00.000Z",
                      "updated_at": "2026-05-13T00:00:00.000Z"
                    }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      },
      "patch": {
        "tags": ["User"],
        "summary": "Update current user profile",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "minProperties": 1,
                "properties": {
                  "name": { "type": "string", "maxLength": 100, "example": "Budi Updated" },
                  "phone": { "type": "string", "maxLength": 16, "example": "089876543210" },
                  "birthday": { "type": "string", "format": "date", "example": "2000-01-01" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Profile updated",
            "content": {
              "application/json": {
                "example": {
                  "status": "success",
                  "message": "Profile updated",
                  "data": { "user": {} }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/categories": {
      "get": {
        "tags": ["Category"],
        "summary": "Get all default categories",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Default categories retrieved",
            "content": {
              "application/json": {
                "example": {
                  "status": "success",
                  "message": "Default categories retrieved",
                  "data": {
                    "categories": [
                      { "id": "uuid", "name": "makanan" },
                      { "id": "uuid", "name": "transport" },
                      { "id": "uuid", "name": "hiburan" },
                      { "id": "uuid", "name": "belanja" },
                      { "id": "uuid", "name": "kesehatan" },
                      { "id": "uuid", "name": "tagihan" },
                      { "id": "uuid", "name": "lainnya" }
                    ]
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/categories/custom": {
      "get": {
        "tags": ["Category"],
        "summary": "Get all custom categories for current user",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "User categories retrieved",
            "content": {
              "application/json": {
                "example": {
                  "status": "success",
                  "message": "User categories retrieved",
                  "data": {
                    "categories": [
                      {
                        "id": "uuid",
                        "user_id": "uuid",
                        "name": "investasi",
                        "created_at": "2026-05-13T00:00:00.000Z"
                      }
                    ]
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      },
      "post": {
        "tags": ["Category"],
        "summary": "Create a new custom category",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name"],
                "properties": {
                  "name": { "type": "string", "maxLength": 100, "example": "investasi" }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Category created",
            "content": {
              "application/json": {
                "example": {
                  "status": "success",
                  "message": "Category created",
                  "data": {
                    "category": {
                      "id": "uuid",
                      "user_id": "uuid",
                      "name": "investasi",
                      "created_at": "2026-05-13T00:00:00.000Z"
                    }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "409": {
            "description": "Category name already exists",
            "content": {
              "application/json": {
                "example": { "status": "error", "message": "Category with that name already exists" }
              }
            }
          }
        }
      }
    },
    "/categories/custom/{id}": {
      "patch": {
        "tags": ["Category"],
        "summary": "Update a custom category",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name"],
                "properties": {
                  "name": { "type": "string", "maxLength": 100, "example": "tabungan" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Category updated",
            "content": {
              "application/json": {
                "example": {
                  "status": "success",
                  "message": "Category updated",
                  "data": {
                    "category": {
                      "id": "uuid",
                      "user_id": "uuid",
                      "name": "tabungan",
                      "created_at": "2026-05-13T00:00:00.000Z"
                    }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "delete": {
        "tags": ["Category"],
        "summary": "Delete a custom category",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": {
            "description": "Category deleted",
            "content": {
              "application/json": {
                "example": { "status": "success", "message": "Category deleted" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    }
  }
}